[Unit]
Description=Personal Obsidian Markdown Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=content
Group=content
WorkingDirectory=/opt/personal-content-infrastructure
EnvironmentFile=/etc/personal-content/obsidian-helper.env
Environment=PYTHONPATH=/opt/personal-content-infrastructure
ExecStart=/opt/personal-content-infrastructure/.venv/bin/uvicorn src.obsidian_helper.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/obsidian-vault

[Install]
WantedBy=multi-user.target
