[Unit]
Description=Personal Content Codex LLM Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=content
Group=content
WorkingDirectory=/opt/personal-content-infrastructure
EnvironmentFile=/etc/personal-content/codex-bridge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/personal-content-infrastructure/.venv/bin/python host_bridge/codex_bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/personal-content

[Install]
WantedBy=multi-user.target
