TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Docker: the Windows folder containing your Obsidian vault. Use forward slashes.
HOST_VAULT_PATH=C:/Users/your-name/Documents/Obsidian/My Knowledge
# Docker always writes inside this mount point. Do not replace it with a Windows path.
VAULT_PATH=/app/vault
ALLOWED_USER_IDS=12345678,87654321

# Markdown service. Use a long random value; bind the service to localhost.
OBSIDIAN_HELPER_API_TOKEN=replace-with-a-long-random-secret
OBSIDIAN_HELPER_HOST=127.0.0.1
OBSIDIAN_HELPER_PORT=8080
MAX_NOTE_BYTES=2000000
# In Docker, collector sends notes to the helper instead of writing the Vault.
OBSIDIAN_HELPER_URL=http://obsidian-helper:8080

# Optional LLM enrichment. Leave disabled to retain the original capture flow.
LLM_ENABLED=false
LLM_PROVIDER=openai # or codex-cli, codex-bridge
LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Codex CLI provider: install Codex and sign in on the host running this bot.
# CODEX_COMMAND=codex
# CODEX_TIMEOUT_SECONDS=120

# Windows Codex bridge provider for a Dockerized bot. Run host_bridge/codex_bridge.py
# directly on Windows, then point the container at Docker Desktop's host gateway.
# CODEX_BRIDGE_URL=http://host.docker.internal:8765
# CODEX_BRIDGE_TOKEN=replace-with-a-long-random-secret
